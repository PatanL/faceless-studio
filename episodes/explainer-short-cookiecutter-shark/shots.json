     "keyframes": [{"t": "@cookiecutter", "x": "50%", "y": "34%", "scale": 40}, {"t": "@next", "x": "50%", "y": "34%", "scale": 40}, {"t": "@blue.end", "x": "62%", "y": "37%", "scale": 1, "ease": "inOut"}],
     "props": {"pxPerM": 34, "glow": 0.8}},
    {"type": "component", "name": "explainer/ScaleBar", "x": "50%", "y": "42%", "width": 680, "height": 130, "z": 4, "depth": 0, "end": "@next",
     "props": {"label": "~50 CM", "at": "@half", "labelSize": 52}},
    {"type": "component", "name": "explainer/Tag", "x": "50%", "y": "52%", "width": 600, "height": 124, "z": 20, "depth": 0,
     "props": {"text": "PENCIL ON A BUS", "at": "@pencil", "size": 52, "align": "center", "accent": "#f3f6f7"}}
   ],
   "camera": {"keyframes": [{"t": 0, "zoom": 1.0}, {"t": "@cookiecutter", "zoom": 1.06}, {"t": "@metre", "zoom": 1.1}, {"t": "@next", "zoom": 1.0}, {"t": "@whale", "zoom": 1.02}, {"t": "@bus.end", "zoom": 1.08, "x": "56%", "y": "40%"}]}},

  {"p": 4, "beat": "depth + bait",
