     "props": {"pxPerM": 1400, "glow": [{"t": 0, "v": 0}, {"t": "@rises", "v": 0}, {"t": "@green", "v": 1, "ease": "out"}]}},
    {"type": "svg", "x": "58.8%", "y": "40%", "width": 140, "height": 140, "z": 4, "start": "@dark",
     "enter": {"type": "pop", "at": "@dark", "duration": 0.3},
     "idle": [{"type": "pulse", "amount": 0.08, "speed": 1.2}],
     "markup": "<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><circle cx='100' cy='100' r='88' fill='none' stroke='#f3f6f7' stroke-width='8'/></svg>"},
    {"type": "component", "name": "explainer/Headline", "x": "50%", "y": "15%", "width": 1000, "height": 330, "z": 20, "depth": 0,
     "props": {"text": "THE BAIT", "red": "BAIT", "sub": "SCIENTISTS' BEST GUESS", "at": "@bait-0.3", "size": 96, "color": "white", "underline": false}}
