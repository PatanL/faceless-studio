     "markup": "<svg viewBox='0 0 200 150' xmlns='http://www.w3.org/2000/svg'><ellipse cx='100' cy='75' rx='70' ry='50' fill='#0b1a22'/><ellipse cx='100' cy='75' rx='86' ry='64' fill='none' stroke='#f3f6f7' stroke-width='8'/></svg>"},
    {"type": "component", "name": "explainer/Cookiecutter", "x": "50%", "y": "33%", "width": 680, "height": 120, "z": 3,
