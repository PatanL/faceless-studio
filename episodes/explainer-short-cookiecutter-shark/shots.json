                  "props": {"depth": [{"t": 0, "v": 40}, {"t": "@kilometre.end", "v": 1000, "ease": "out"}, {"t": "@night", "v": 1000}, {"t": "@green", "v": 120}], "rays": 7, "snow": 60}},
   "transitionIn": {"type": "fade", "duration": 0.3},
