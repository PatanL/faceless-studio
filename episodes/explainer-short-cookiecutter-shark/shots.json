   "transitionIn": {"type": "fade", "duration": 0.3},
   "layers": [
    {"type": "component", "name": "explainer/Headline", "x": "50%", "y": "15%", "width": 1000, "height": 310, "z": 20, "depth": 0,
     "props": {"text": "THE ONE\nWHALES FEAR", "at": 0, "out": "@cookiecutter", "size": 88, "color": "red", "underline": false}},
    {"type": "component", "name": "explainer/BlueWhale", "x": "50%", "y": "36%", "width": 1000, "height": 320, "z": 1, "start": "@next",
     "enter": {"type": "fade", "at": "@next", "duration": 0.4},
     "props": {"pxPerM": 34, "speed": 0.7}},
    {"type": "component", "name": "explainer/Cookiecutter", "x": "50%", "y": "34%", "width": 40, "height": 20, "z": 3, "start": "@cookiecutter",
