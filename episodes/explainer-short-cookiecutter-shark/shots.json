    {"type": "component", "name": "explainer/Options", "x": "50%", "y": "52%", "width": 1000, "height": 520, "z": 20, "depth": 0,
     "props": {"title": "3 TOOLS", "items": ["SUCTION LIPS", "HOOK TEETH", "SAW TEETH"], "at": -0.6, "itemAt": [-0.6, -0.6, -0.6], "size": 56, "out": "@then",
               "select": [{"index": 0, "at": -0.6}, {"index": 1, "at": -0.6}, {"index": 2, "at": "@triangle"}]}},
    {"type": "svg", "x": "50%", "y": "53%", "width": 300, "height": 220, "z": 3, "start": "@spins",
