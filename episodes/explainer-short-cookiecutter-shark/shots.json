    {"type": "component", "name": "explainer/GreatWhite", "x": "50%", "y": "25%", "width": 760, "height": 280, "z": 2, "start": "@forget#2", "end": "@forget#3",
     "keyframes": [{"t": "@forget#2", "x": "140%"}, {"t": "@tiger", "x": "50%", "ease": "out"}, {"t": "@sharks.end", "x": "50%"}, {"t": "@forget#3", "x": "-40%", "ease": "in"}],
     "props": {"silhouette": "#7b8a80", "speed": 1.2}},
    {"type": "svg", "x": "50%", "y": "25%", "width": 540, "height": 360, "z": 2, "start": "@forget#3",
     "enter": {"type": "pop", "at": "@forget#3", "duration": 0.3},
     "keyframes": [{"t": "@forget#3", "scale": 1}, {"t": "@movie", "scale": 1.1}, {"t": "@scared.end", "scale": 1.2}],
     "markup": "<svg viewBox='0 0 300 200' xmlns='http://www.w3.org/2000/svg'><path d='M0 150 Q75 135 150 150 T300 150 L300 200 L0 200 Z' fill='#4f6f7a'/><path d='M120 150 Q150 60 200 30 Q185 90 200 150 Z' fill='#9aa7ad'/></svg>"},
    {"type": "component", "name": "explainer/Options", "x": "50%", "y": "50%", "width": 1000, "height": 540, "z": 20, "depth": 0,
     "props": {"title": "FORGET", "items": ["GREAT WHITE", "TIGER SHARK", "EVERY MOVIE SHARK"], "at": 0, "size": 56,
               "itemAt": [0, "@forget#2", "@forget#3"],
               "strikes": [{"index": 0, "at": "@whites"}, {"index": 1, "at": "@sharks"}, {"index": 2, "at": "@scared"}]}}
   ],
   "camera": {"keyframes": [{"t": 0, "zoom": 1.0}, {"t": "@forget#2", "zoom": 1.04}, {"t": "@forget#3", "zoom": 1.0}, {"t": "@grew", "zoom": 1.06}, {"t": "@scared.end", "zoom": 1.08}]}},

  {"p": 3, "beat": "pivot + true scale (blue whale 28 m and cookiecutter 0.5 m both at 34 px/m; the shark is scaled x40 for the close-up)",
