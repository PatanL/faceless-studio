    {"type": "component", "name": "explainer/GreatWhite", "x": "50%", "y": "25%", "width": 760, "height": 280, "z": 2, "end": "@forget#2",
     "keyframes": [{"t": 0, "x": "50%"}, {"t": "@whites.end", "x": "50%"}, {"t": "@forget#2", "x": "-40%", "ease": "in"}],
