     "props": {"text": "HOLE SAW", "at": "@hole+0.1", "size": 52, "align": "center", "accent": "#f3f6f7"}}
   ],
   "camera": {"keyframes": [{"t": 0, "zoom": 1.04}, {"t": "@triangle", "zoom": 1.1}, {"t": "@saw", "zoom": 1.14}, {"t": "@then", "zoom": 1.0}, {"t": "@hole", "zoom": 1.06}],
              "shake": [{"at": "@spins", "duration": 0.5, "amplitude": 10}]}},

  {"p": 7, "beat": "payoff on the whale",
   "background": {"type": "component", "name": "explainer/Ocean", "depth": 0.12, "overscan": 1.2, "props": {"depth": 30, "rays": 7, "snow": 60}},
