{
 "niche": "explainer",
 "emphasis": ["circles", "cookiecutter,", "bait.", "saw.", "five", "gone.", "submarines."],
 "glue": ["great whites", "tiger sharks", "blue whale", "hole saw"],
 "scenes": [
  {"p": 1, "beat": "hook",
   "background": {"type": "component", "name": "explainer/Ocean", "depth": 0.12, "overscan": 1.2, "props": {"depth": 20, "rays": 7, "snow": 60}},
   "layers": [
    {"type": "svg", "x": "50%", "y": "55%", "width": 1200, "height": 600, "z": 1,
     "markup": "<svg viewBox='0 0 1200 600' xmlns='http://www.w3.org/2000/svg'><path d='M0 150 Q600 30 1200 150 L1200 600 L0 600 Z' fill='#7d8a90'/><path d='M0 260 Q600 150 1200 260 M0 360 Q600 250 1200 360 M0 460 Q600 350 1200 460' stroke='#93a0a6' stroke-width='10' fill='none'/><circle cx='230' cy='300' r='26' fill='none' stroke='#b9c3c7' stroke-width='6' opacity='0.6'/><circle cx='980' cy='330' r='22' fill='none' stroke='#b9c3c7' stroke-width='6' opacity='0.6'/></svg>"},
