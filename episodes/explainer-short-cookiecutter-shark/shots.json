  {"p": 6, "beat": "tool 3 + spin",
   "background": {"type": "component", "name": "explainer/Ocean", "depth": 0.12, "overscan": 1.2, "props": {"depth": 150, "rays": 7, "snow": 60}},
   "transitionIn": {"type": "fade", "duration": 0.3},
