[{"start": 0.02, "end": 6.74, "text": "This is a whale. It's called Pachacetus. It lived some 50 million years ago.", "words": [[0.02, 0.64, " This"], [0.64, 1.12, " is"], [1.12, 1.32, " a"], [1.32, 1.48, " whale."], [2.44, 2.68, " It's"], [2.68, 2.9, " called"], [2.9, 3.5, " Pachacetus."], [4.1, 4.32, " It"], [4.32, 4.64, " lived"], [4.64, 5.14, " some"], [5.14, 5.62, " 50"], [5.62, 6.04, " million"], [6.04, 6.42, " years"], [6.42, 6.74, " ago."]]}, {"start": 7.34, "end": 12.5, "text": "Scientists have found out that today's whales could be traced back to this dog-sized terrestrial creature.", "words": [[7.34, 7.94, " Scientists"], [7.94, 8.24, " have"], [8.24, 8.48, " found"], [8.48, 8.68, " out"], [8.68, 8.84, " that"], [8.84, 9.36, " today's"], [9.36, 9.54, " whales"], [9.54, 9.78, " could"], [9.78, 9.9, " be"], [9.9, 10.12, " traced"], [10.12, 10.42, " back"], [10.42, 10.64, " to"], [10.64, 10.82, " this"], [10.82, 11.08, " dog"], [11.08, 11.38, "-sized"], [11.38, 12.12, " terrestrial"], [12.12, 12.5, " creature."]]}, {"start": 12.98, "end": 17.02, "text": "But how did it change so drastically to become the biggest animal on Earth?", "words": [[12.98, 13.18, " But"], [13.18, 13.36, " how"], [13.36, 13.48, " did"], [13.48, 13.62, " it"], [13.62, 13.94, " change"], [13.94, 14.18, " so"], [14.18, 14.6, " drastically"], [14.6, 15.04, " to"], [15.04, 15.32, " become"], [15.32, 15.64, " the"], [15.64, 15.88, " biggest"], [15.88, 16.4, " animal"], [16.4, 16.78, " on"], [16.78, 17.02, " Earth?"]]}, {"start": 17.68, "end": 18.36, "text": "Let's investigate.", "words": [[17.68, 18.04, " Let's"], [18.04, 18.36, " investigate."]]}, {"start": 19.3, "end": 23.0, "text": "The fossilized remnants of Pachacetus were found in the mountains of Pakistan.", "words": [[19.3, 19.54, " The"], [19.54, 20.12, " fossilized"], [20.12, 20.4, " remnants"], [20.4, 20.7, " of"], [20.7, 21.22, " Pachacetus"], [21.22, 21.5, " were"], [21.5, 21.74, " found"], [21.74, 21.92, " in"], [21.92, 22.02, " the"], [22.02, 22.28, " mountains"], [22.28, 22.58, " of"], [22.58, 23.0, " Pakistan."]]}, {"start": 23.64, "end": 27.88, "text": "During their time, this was a lush region with many freshwater riverbeds", "words": [[23.64, 24.12, " During"], [24.12, 24.36, " their"], [24.36, 24.66, " time,"], [24.82, 25.0, " this"], [25.0, 25.24, " was"], [25.24, 25.42, " a"], [25.42, 25.68, " lush"], [25.68, 26.04, " region"], [26.04, 26.34, " with"], [26.34, 26.62, " many"], [26.62, 27.08, " freshwater"], [27.08, 27.88, " riverbeds"]]}, {"start": 27.88, "end": 30.9, "text": "where these fuzzy little mammals would doggie paddle out to fish.", "words": [[27.88, 28.16, " where"], [28.16, 28.42, " these"], [28.42, 28.78, " fuzzy"], [28.78, 29.02, " little"], [29.02, 29.38, " mammals"], [29.38, 29.64, " would"], [29.64, 30.0, " doggie"], [30.0, 30.22, " paddle"], [30.22, 30.44, " out"], [30.44, 30.6, " to"], [30.6, 30.9, " fish."]]}, {"start": 31.14, "end": 35.74, "text": "Eye sockets near the top of the head and heavy bones to keep them submerged in shallow water", "words": [[31.14, 31.7, " Eye"], [31.7, 32.02, " sockets"], [32.02, 32.28, " near"], [32.28, 32.38, " the"], [32.38, 32.56, " top"], [32.56, 32.66, " of"], [32.66, 32.74, " the"], [32.74, 32.96, " head"], [32.96, 33.28, " and"], [33.28, 33.52, " heavy"], [33.52, 33.88, " bones"], [33.88, 34.06, " to"], [34.06, 34.18, " keep"], [34.18, 34.36, " them"], [34.36, 34.82, " submerged"], [34.82, 35.08, " in"], [35.08, 35.34, " shallow"], [35.34, 35.74, " water"]]}, {"start": 35.74, "end": 38.82, "text": "probably made them good semi-aquatic hunters as well.", "words": [[35.74, 36.24, " probably"], [36.24, 36.6, " made"], [36.6, 36.78, " them"], [36.78, 37.06, " good"], [37.06, 37.48, " semi"], [37.48, 37.9, "-aquatic"], [37.9, 38.28, " hunters"], [38.28, 38.54, " as"], [38.54, 38.82, " well."]]}, {"start": 39.7, "end": 41.94, "text": "As the supercontinent Pangaea broke apart,", "words": [[39.7, 39.94, " As"], [39.94, 40.12, " the"], [40.12, 40.72, " supercontinent"], [40.72, 41.4, " Pangaea"], [41.4, 41.52, " broke"], [41.52, 41.94, " apart,"]]}, {"start": 42.28, "end": 45.98, "text": "the gap between the emerging continents Laurasia and Gondwana filled with water", "words": [[42.28, 42.34, " the"], [42.34, 42.52, " gap"], [42.52, 42.8, " between"], [42.8, 42.96, " the"], [42.96, 43.28, " emerging"], [43.28, 43.7, " continents"], [43.7, 44.42, " Laurasia"], [44.42, 44.64, " and"], [44.64, 45.12, " Gondwana"], [45.12, 45.46, " filled"], [45.46, 45.64, " with"], [45.64, 45.98, " water"]]}, {"start": 45.98, "end": 48.02, "text": "creating the shallow Tethys Sea.", "words": [[45.98, 46.54, " creating"], [46.54, 46.82, " the"], [46.82, 47.1, " shallow"], [47.1, 47.7, " Tethys"], [47.7, 48.02, " Sea."]]}, {"start": 48.64, "end": 52.72, "text": "Fossils from the Eocene show creatures that adapted to life in the new environment.", "words": [[48.64, 49.08, " Fossils"], [49.08, 49.28, " from"], [49.28, 49.4, " the"], [49.4, 49.96, " Eocene"], [49.96, 50.24, " show"], [50.24, 50.58, " creatures"], [50.58, 50.82, " that"], [50.82, 51.18, " adapted"], [51.18, 51.48, " to"], [51.48, 51.72, " life"], [51.72, 51.98, " in"], [51.98, 52.08, " the"], [52.08, 52.26, " new"], [52.26, 52.72, " environment."]]}, {"start": 52.72, "end": 56.16, "text": "Shorter legs would have made them awkward guests on land,", "words": [[52.72, 53.84, " Shorter"], [53.84, 54.12, " legs"], [54.12, 54.36, " would"], [54.36, 54.48, " have"], [54.48, 54.62, " made"], [54.62, 54.8, " them"], [54.8, 55.14, " awkward"], [55.14, 55.58, " guests"], [55.58, 55.88, " on"], [55.88, 56.16, " land,"]]}, {"start": 56.52, "end": 58.48, "text": "gracelessly hopping around like sea lions,", "words": [[56.52, 57.08, " gracelessly"], [57.08, 57.3, " hopping"], [57.3, 57.56, " around"], [57.56, 57.9, " like"], [57.9, 58.18, " sea"], [58.18, 58.48, " lions,"]]}, {"start": 58.8, "end": 62.6, "text": "but powerfully propelling themselves underwater by kicking their hind limbs", "words": [[58.8, 58.98, " but"], [58.98, 59.54, " powerfully"], [59.54, 59.9, " propelling"], [59.9, 60.2, " themselves"], [60.2, 60.9, " underwater"], [60.9, 61.44, " by"], [61.44, 61.68, " kicking"], [61.68, 61.96, " their"], [61.96, 62.22, " hind"], [62.22, 62.6, " limbs"]]}, {"start": 62.6, "end": 65.64, "text": "and waving their thicker spinal column like an otter.", "words": [[62.6, 63.12, " and"], [63.12, 63.48, " waving"], [63.48, 63.78, " their"], [63.78, 64.06, " thicker"], [64.06, 64.46, " spinal"], [64.46, 64.9, " column"], [64.9, 65.2, " like"], [65.2, 65.38, " an"], [65.38, 65.64, " otter."]]}, {"start": 66.26, "end": 69.04, "text": "Some even show nostrils moved up their head,", "words": [[66.26, 66.62, " Some"], [66.62, 67.06, " even"], [67.06, 67.36, " show"], [67.36, 67.86, " nostrils"], [67.86, 68.3, " moved"], [68.3, 68.5, " up"], [68.5, 68.74, " their"], [68.74, 69.04, " head,"]]}, {"start": 69.22, "end": 72.64, "text": "making them the earliest blowholes, ideal for breathing in water.", "words": [[69.22, 69.52, " making"], [69.52, 69.76, " them"], [69.76, 69.92, " the"], [69.92, 70.3, " earliest"], [70.3, 70.96, " blowholes,"], [71.22, 71.6, " ideal"], [71.6, 71.9, " for"], [71.9, 72.18, " breathing"], [72.18, 72.38, " in"], [72.38, 72.64, " water."]]}, {"start": 73.7, "end": 79.0, "text": "The next exhibit, Bacillosaurids and Dorodontines that lived 40 million years ago.", "words": [[73.7, 73.82, " The"], [73.82, 74.06, " next"], [74.06, 74.46, " exhibit,"], [75.0, 75.78, " Bacillosaurids"], [75.78, 76.24, " and"], [76.24, 77.06, " Dorodontines"], [77.06, 77.5, " that"], [77.5, 77.68, " lived"], [77.68, 78.14, " 40"], [78.14, 78.42, " million"], [78.42, 78.7, " years"], [78.7, 79.0, " ago."]]}, {"start": 79.46, "end": 82.06, "text": "Creatures that we would recognize as whales today.", "words": [[79.46, 79.78, " Creatures"], [79.78, 79.96, " that"], [79.96, 80.1, " we"], [80.1, 80.32, " would"], [80.32, 80.84, " recognize"], [80.84, 81.28, " as"], [81.28, 81.66, " whales"], [81.66, 82.06, " today."]]}, {"start": 82.7, "end": 85.66, "text": "Their remains were found in fossil beds of proper oceans", "words": [[82.7, 83.26, " Their"], [83.26, 83.54, " remains"], [83.54, 83.78, " were"], [83.78, 84.0, " found"], [84.0, 84.18, " in"], [84.18, 84.46, " fossil"], [84.46, 84.78, " beds"], [84.78, 84.98, " of"], [84.98, 85.28, " proper"], [85.28, 85.66, " oceans"]]}, {"start": 85.66, "end": 90.08, "text": "and they showed hind limbs so small they may not even have stuck out from their body.", "words": [[85.66, 86.1, " and"], [86.1, 86.28, " they"], [86.28, 86.58, " showed"], [86.58, 86.9, " hind"], [86.9, 87.16, " limbs"], [87.16, 87.56, " so"], [87.56, 87.96, " small"], [87.96, 88.3, " they"], [88.3, 88.46, " may"], [88.46, 88.62, " not"], [88.62, 88.86, " even"], [88.86, 89.02, " have"], [89.02, 89.22, " stuck"], [89.22, 89.46, " out"], [89.46, 89.62, " from"], [89.62, 89.8, " their"], [89.8, 90.08, " body."]]}, {"start": 90.8, "end": 93.12, "text": "With no connection between hip bone and spine,", "words": [[90.8, 91.2, " With"], [91.2, 91.44, " no"], [91.44, 91.82, " connection"], [91.82, 92.12, " between"], [92.12, 92.42, " hip"], [92.42, 92.64, " bone"], [92.64, 92.82, " and"], [92.82, 93.12, " spine,"]]}, {"start": 93.48, "end": 95.5, "text": "they probably couldn't have ventured onto land anymore.", "words": [[93.48, 93.54, " they"], [93.54, 93.86, " probably"], [93.86, 94.26, " couldn't"], [94.26, 94.36, " have"], [94.36, 94.68, " ventured"], [94.68, 94.82, " onto"], [94.82, 95.12, " land"], [95.12, 95.5, " anymore."]]}, {"start": 96.28, "end": 98.08, "text": "Over the next tens of millions of years,", "words": [[96.28, 96.52, " Over"], [96.52, 96.64, " the"], [96.64, 96.84, " next"], [96.84, 97.14, " tens"], [97.14, 97.36, " of"], [97.36, 97.58, " millions"], [97.58, 97.84, " of"], [97.84, 98.08, " years,"]]}, {"start": 98.48, "end": 102.2, "text": "this family of animals would branch out to countless species all over the planet,", "words": [[98.48, 98.64, " this"], [98.64, 98.96, " family"], [98.96, 99.1, " of"], [99.1, 99.38, " animals"], [99.38, 99.66, " would"], [99.66, 99.94, " branch"], [99.94, 100.24, " out"], [100.24, 100.4, " to"], [100.4, 100.7, " countless"], [100.7, 101.12, " species"], [101.12, 101.56, " all"], [101.56, 101.84, " over"], [101.84, 101.94, " the"], [101.94, 102.2, " planet,"]]}, {"start": 102.5, "end": 106.02, "text": "including the blue whale, the largest animal in the history of life.", "words": [[102.5, 102.92, " including"], [102.92, 103.18, " the"], [103.18, 103.36, " blue"], [103.36, 103.6, " whale,"], [104.0, 104.12, " the"], [104.12, 104.42, " largest"], [104.42, 104.8, " animal"], [104.8, 105.08, " in"], [105.08, 105.2, " the"], [105.2, 105.54, " history"], [105.54, 105.74, " of"], [105.74, 106.02, " life."]]}, {"start": 106.64, "end": 110.58, "text": "Although we don't know exactly whether these animals were direct descendants of each other", "words": [[106.64, 106.92, " Although"], [106.92, 107.16, " we"], [107.16, 107.32, " don't"], [107.32, 107.48, " know"], [107.48, 107.84, " exactly"], [107.84, 108.16, " whether"], [108.16, 108.4, " these"], [108.4, 108.7, " animals"], [108.7, 108.98, " were"], [108.98, 109.4, " direct"], [109.4, 109.9, " descendants"], [109.9, 110.18, " of"], [110.18, 110.34, " each"], [110.34, 110.58, " other"]]}, {"start": 110.58, "end": 115.3, "text": "or evolved in parallel, we have several compelling clues that they are indeed related.", "words": [[110.58, 110.98, " or"], [110.98, 111.38, " evolved"], [111.38, 111.7, " in"], [111.7, 112.06, " parallel,"], [112.48, 112.56, " we"], [112.56, 112.78, " have"], [112.78, 113.22, " several"], [113.22, 113.62, " compelling"], [113.62, 114.0, " clues"], [114.0, 114.2, " that"], [114.2, 114.36, " they"], [114.36, 114.5, " are"], [114.5, 114.8, " indeed"], [114.8, 115.3, " related."]]}, {"start": 116.06, "end": 118.8, "text": "All these fossils share the same kind of ear bones", "words": [[116.06, 116.32, " All"], [116.32, 116.56, " these"], [116.56, 116.92, " fossils"], [116.92, 117.48, " share"], [117.48, 117.66, " the"], [117.66, 117.96, " same"], [117.96, 118.18, " kind"], [118.18, 118.36, " of"], [118.36, 118.58, " ear"], [118.58, 118.8, " bones"]]}, {"start": 118.8, "end": 121.82, "text": "that gradually specialized for hearing underwater.", "words": [[118.8, 119.28, " that"], [119.28, 119.68, " gradually"], [119.68, 120.28, " specialized"], [120.28, 120.84, " for"], [120.84, 121.12, " hearing"], [121.12, 121.82, " underwater."]]}, {"start": 122.74, "end": 126.7, "text": "DNA analysis has shown that whales are actually closely related to", "words": [[122.74, 123.3, " DNA"], [123.3, 123.78, " analysis"], [123.78, 124.12, " has"], [124.12, 124.38, " shown"], [124.38, 124.54, " that"], [124.54, 124.92, " whales"], [124.92, 125.26, " are"], [125.26, 125.62, " actually"], [125.62, 126.02, " closely"], [126.02, 126.4, " related"], [126.4, 126.7, " to"]]}, {"start": 126.7, "end": 129.5, "text": "even toad hoofed animals like hippos or pigs.", "words": [[126.7, 127.04, " even"], [127.04, 127.4, " toad"], [127.4, 127.74, " hoofed"], [127.74, 127.9, " animals"], [127.9, 128.44, " like"], [128.44, 128.94, " hippos"], [128.94, 129.2, " or"], [129.2, 129.5, " pigs."]]}, {"start": 130.32, "end": 133.92, "text": "And finally, the Pachacetus shows a distinctive ankle bone", "words": [[130.32, 130.54, " And"], [130.54, 130.94, " finally,"], [131.3, 131.36, " the"], [131.36, 131.88, " Pachacetus"], [131.88, 132.3, " shows"], [132.3, 132.58, " a"], [132.58, 133.1, " distinctive"], [133.1, 133.58, " ankle"], [133.58, 133.92, " bone"]]}, {"start": 133.92, "end": 136.72, "text": "linking them to the ancestral family of hippos.", "words": [[133.92, 134.38, " linking"], [134.38, 134.66, " them"], [134.66, 134.82, " to"], [134.82, 134.96, " the"], [134.96, 135.54, " ancestral"], [135.54, 136.08, " family"], [136.08, 136.28, " of"], [136.28, 136.72, " hippos."]]}, {"start": 137.38, "end": 139.46, "text": "This is the power of evolution.", "words": [[137.38, 137.8, " This"], [137.8, 138.24, " is"], [138.24, 138.4, " the"], [138.4, 138.7, " power"], [138.7, 138.9, " of"], [138.9, 139.46, " evolution."]]}, {"start": 139.46, "end": 145.06, "text": "Completely rebuilding an animal with small changes over millions and millions of years.", "words": [[139.46, 140.42, " Completely"], [140.42, 140.94, " rebuilding"], [140.94, 141.22, " an"], [141.22, 141.56, " animal"], [141.56, 141.8, " with"], [141.8, 142.1, " small"], [142.1, 142.44, " changes"], [142.44, 142.98, " over"], [142.98, 143.42, " millions"], [143.42, 143.86, " and"], [143.86, 144.32, " millions"], [144.32, 144.74, " of"], [144.74, 145.06, " years."]]}, {"start": 145.42, "end": 148.4, "text": "It may be one of the most impressive things on Earth.", "words": [[145.42, 145.78, " It"], [145.78, 146.0, " may"], [146.0, 146.18, " be"], [146.18, 146.38, " one"], [146.38, 146.48, " of"], [146.48, 146.58, " the"], [146.58, 146.76, " most"], [146.76, 147.4, " impressive"], [147.4, 147.86, " things"], [147.86, 148.12, " on"], [148.12, 148.4, " Earth."]]}, {"start": 149.14, "end": 150.62, "text": "Or would you believe that...", "words": [[149.14, 149.5, " Or"], [149.5, 149.84, " would"], [149.84, 150.0, " you"], [150.0, 150.28, " believe"], [150.28, 150.62, " that..."]]}]