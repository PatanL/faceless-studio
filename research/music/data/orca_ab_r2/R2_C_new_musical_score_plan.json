     19.346000000000004,
     "section"
    ]
   ],
   "text": "It hits fifty-six kilometres an hour. An Olympic swimmer manages eight. You, maybe three. From fifty metres out, it reaches you in three seconds.",
   "role": "",
   "key": 2,
   "chords": [
    [
     10.866,
     14.8566,
     11,
     "min7",
     0.49882352941176494
