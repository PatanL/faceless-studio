    [
     45.51500000000001,
     51.42900000000001,
     "place"
    ]
   ],
   "text": "In 2019, off Western Australia, a pod brought down the biggest animal on Earth. An adult blue whale, a thousand times your weight.",
   "role": "",
   "key": 2,
   "chords": [
    [
     42.703,
     46.8094,
