 "lines": [
  {
   "id": "n1",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 0.25,
   "end": 2.52,
   "text": "My own number texted me. Sent at two thirty-one."
  },
  {
   "id": "n2",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 2.72,
   "end": 3.66,
   "text": "It was one fifty-two."
  },
  {
   "id": "m1",
   "spk": "M",
   "voice": "af_heart",
   "speed": 1.1,
   "start": 3.91,
   "end": 10.06,
   "text": "At two fourteen the office will call a gas leak and send everyone up to the roof. Don't go. Not even if they beg."
  },
  {
   "id": "n3",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 10.36,
   "end": 12.57,
   "text": "I typed, who is this? It answered before I hit send."
  },
  {
   "id": "m2",
   "spk": "M",
   "voice": "af_heart",
   "speed": 1.1,
   "start": 12.87,
   "end": 13.93,
   "text": "You. Check your left sock."
  },
  {
   "id": "n4",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 14.23,
   "end": 15.59,
   "text": "I looked. A hole, at the big toe."
  },
  {
   "id": "m3",
   "spk": "M",
   "voice": "af_heart",
   "speed": 1.1,
   "start": 15.89,
   "end": 21.8,
   "text": "First, the hall goes dark, door by door. The dog downstairs stops mid-bark. The office types for a full minute."
  },
  {
   "id": "o1",
   "spk": "O",
   "voice": "bm_george",
   "speed": 1.15,
   "start": 22.1,
   "end": 25.2,
   "text": "Roof closed. Padlocked. Only the office has the key."
  },
  {
   "id": "n5",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 25.5,
   "end": 27.21,
   "text": "My door's the last one before the roof stairs."
  },
  {
   "id": "n6",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 27.41,
   "end": 30.34,
   "text": "Then the far end of the hall went dark. Then the next light. Then mine."
  },
  {
   "id": "n7",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 30.54,
   "end": 32.17,
   "text": "Downstairs, the dog stopped mid-bark."
  },
  {
   "id": "n8",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 32.37,
   "end": 34.32,
   "text": "Then the office started typing. For a full minute."
  },
  {
   "id": "n9",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 35.42,
   "end": 36.03,
   "text": "Two fourteen."
  },
  {
   "id": "o2",
   "spk": "O",
   "voice": "bm_george",
   "speed": 1.15,
   "start": 36.18,
   "end": 39.33,
   "text": "Gas leak. Everyone up to the roof. The door is open."
  },
  {
   "id": "d1",
   "spk": "D",
   "voice": "af_sky",
   "speed": 1.3,
   "start": 39.63,
   "end": 40.36,
   "text": "Everyone up!"
  },
  {
   "id": "l1",
   "spk": "L",
   "voice": "bf_isabella",
   "speed": 1.25,
   "start": 40.51,
   "end": 42.04,
   "text": "Why up? You go out in a gas leak."
  },
  {
   "id": "o3",
   "spk": "O",
   "voice": "bm_george",
   "speed": 1.15,
   "start": 42.19,
   "end": 44.14,
   "text": "Stairwell's full of gas. Go now."
  },
  {
   "id": "n10",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 44.44,
   "end": 47.09,
   "text": "Thirty-seven neighbours replied, on my way. Everyone but me."
  },
  {
   "id": "n11",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 47.29,
   "end": 50.02,
   "text": "Then feet went past my door, up the roof stairs. Nobody ran."
  },
  {
   "id": "a1",
   "spk": "A",
   "voice": "am_michael",
   "speed": 1.05,
   "start": 50.32,
   "end": 53.69,
   "text": "Tess. It's Abel, from next door. Everyone is waiting for you."
  },
  {
   "id": "n12",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 53.99,
   "end": 56.2,
   "text": "I didn't open. I'd counted thirty-eight sets of feet."
  },
  {
   "id": "n13",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 56.4,
   "end": 57.24,
   "text": "The office tagged me."
  },
  {
   "id": "o4",
   "spk": "O",
   "voice": "bm_george",
   "speed": 1.15,
   "start": 57.39,
   "end": 59.75,
   "text": "Last one. The roof locks at two thirty."
  },
  {
   "id": "d2",
   "spk": "D",
   "voice": "af_sky",
   "speed": 1.0,
   "start": 60.05,
   "end": 61.37,
   "text": "its so quiet up here"
  },
  {
   "id": "n14",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 61.67,
   "end": 64.15,
   "text": "I typed, Dee? Mrs. Lind? Seen. Nobody answered."
  },
  {
   "id": "n15",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 64.35,
   "end": 66.05,
   "text": "Then one footstep, right above my bed."
  },
  {
   "id": "n16",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 68.85,
   "end": 69.78,
   "text": "I called the gas line."
  },
  {
   "id": "g1",
   "spk": "G",
   "voice": "bf_alice",
   "speed": 1.2,
   "start": 69.98,
   "end": 71.78,
   "text": "No leak reported at that address."
  },
  {
   "id": "n17",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 72.08,
   "end": 75.96,
   "text": "Then I called my own number. It rang. Up on the roof, faintly, my ringtone was playing."
  },
  {
   "id": "n18",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 76.76,
   "end": 79.58,
   "text": "At two thirty-one, the minute on the first text, a new one came in."
  },
  {
   "id": "m4",
   "spk": "M",
   "voice": "af_heart",
   "speed": 1.1,
   "start": 79.88,
   "end": 81.04,
   "text": "I went. Now you have to."
  },
  {
   "id": "n19",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 81.29,
   "end": 83.64,
   "text": "And in the building chat, the office had a new name. Me."
  },
  {
   "id": "n20",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 83.84,
   "end": 86.09,
   "text": "One set of feet came down. They stopped at my door."
  },
  {
   "id": "n21",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 86.29,
   "end": 89.25,
   "text": "I lay flat and looked under. Socks. A hole at the left big toe."
  },
  {
   "id": "n22",
   "spk": "N",
   "voice": "af_heart",
   "speed": 1.3,
   "start": 90.85,
   "end": 91.95,
   "text": "My phone lit up beside me."
  },
  {
   "id": "m5",
   "spk": "M",
   "voice": "af_heart",
   "speed": 1.1,
   "start": 92.25,
   "end": 94.49,
   "text": "Please. I'm begging you. Open up. It's just me."
  }
 ],
